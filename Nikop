{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.3"
  }
}
const express = require("express");
const axios = require("axios");
const sqlite3 = require("sqlite3").verbose();
require("dotenv").config();

const app = express();
app.use(express.json());

const db = new sqlite3.Database("whatsapp_group_stats.db");

db.serialize(() => {
  db.run(`
    CREATE TABLE IF NOT EXISTS mensajes (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      groupId TEXT,
      sender TEXT,
      senderName TEXT,
      mensaje TEXT,
      fecha DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);
});

const PORT = process.env.PORT || 3000;
const token = process.env.WHATSAPP_TOKEN;
const phoneNumberId = process.env.PHONE_NUMBER_ID;

async function sendWhatsAppMessage(to, text) {
  const url = `https://graph.facebook.com/v18.0/${phoneNumberId}/messages`;

  await axios.post(
    url,
    {
      messaging_product: "whatsapp",
      to,
      type: "text",
      text: { body: text }
    },
    {
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json"
      }
    }
  );
}

function guardarMensaje(groupId, sender, senderName, mensaje) {
  db.run(
    `INSERT INTO mensajes (groupId, sender, senderName, mensaje, fecha)
     VALUES (?, ?, ?, ?, datetime('now'))`,
    [groupId, sender, senderName, mensaje]
  );
}

function getTop10Activos(groupId) {
  return new Promise((resolve, reject) => {
    db.all(
      `
      SELECT senderName, COUNT(*) AS total
      FROM mensajes
      WHERE groupId = ?
      GROUP BY sender
      ORDER BY total DESC, senderName ASC
      LIMIT 10
      `,
      [groupId],
      (err, rows) => {
        if (err) reject(err);
        else resolve(rows);
      }
    );
  });
}

function getTop10Inactivos(groupId) {
  return new Promise((resolve, reject) => {
    db.all(
      `
      SELECT senderName,
             MAX(fecha) AS ultimo_mensaje,
             (strftime('%s', 'now') - strftime('%s', MAX(fecha))) / 86400 AS dias_inactivo
      FROM mensajes
      WHERE groupId = ?
      GROUP BY sender
      ORDER BY dias_inactivo DESC, ultimo_mensaje ASC
      LIMIT 10
      `,
      [groupId],
      (err, rows) => {
        if (err) reject(err);
        else resolve(rows);
      }
    );
  });
}

app.get("/", (req, res) => {
  res.send("Bot WhatsApp funcionando");
});

app.get("/webhook", (req, res) => {
  const mode = req.query["hub.mode"];
  const verifyToken = req.query["hub.verify_token"];
  const challenge = req.query["hub.challenge"];

  if (mode === "subscribe" && verifyToken === process.env.VERIFY_TOKEN) {
    res.status(200).send(challenge);
  } else {
    res.sendStatus(403);
  }
});

app.post("/webhook", async (req, res) => {
  const entries = req.body.entry || [];

  for (const entry of entries) {
    const changes = entry.changes || [];

    for (const change of changes) {
      const value = change.value || {};
      const messages = value.messages || [];

      for (const msg of messages) {
        const from = msg.from;
        const text = msg.text?.body || "";
        const groupId = value.metadata?.display_phone_number || from;
        const senderName = msg.from || "Usuario";

        guardarMensaje(groupId, from, senderName, text);

        const comando = text.trim().toLowerCase();

        if (comando === "/top10") {
          const rows = await getTop10Activos(groupId);
          let respuesta = "🏆 TOP 10 MÁS ACTIVOS\n\n";
          if (!rows.length) {
            respuesta += "No hay mensajes aún.";
          } else {
            rows.forEach((row, index) => {
              respuesta += `${index + 1}. ${row.senderName} - ${row.total} mensajes\n`;
            });
          }
          await sendWhatsAppMessage(from, respuesta);
        }

        if (comando === "/inactivos10" || comando === "/inactivos") {
          const rows = await getTop10Inactivos(groupId);
          let respuesta = "💤 TOP 10 MÁS INACTIVOS\n\n";
          if (!rows.length) {
            respuesta += "No hay mensajes aún.";
          } else {
            rows.forEach((row, index) => {
              const dias = Math.floor(Number(row.dias_inactivo) || 0);
              respuesta += `${index + 1}. ${row.senderName} - ${dias} días sin escribir\n`;
            });
          }
          await sendWhatsAppMessage(from, respuesta);
        }
      }
    }
  }

  res.sendStatus(200);
});

app.listen(PORT, () => {
  console.log(`Servidor corriendo en puerto ${PORT}`);
});
